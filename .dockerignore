# --- VCS / editor / Claude ---
.git/
.gitignore
.github/
.claude/
.vscode/
.idea/

# --- Activity (Node) ---
# ホスト側の node_modules を含めると stage1 で npm ci した結果が上書きされ、
# tsc の実行権限が消えて "Permission denied" になるので必ず除外する。
activity/node_modules/
activity/dist/
activity/.vite/
activity/.env
activity/.env.local
activity/.env.*.local

# --- Python ---
python/__pycache__/
python/**/__pycache__/
python/**/*.pyc
# spotipy / spotDL のトークンキャッシュ (ファイル)。イメージに入れない
python/.cache
python/.spotdl-cache
python/dev/
# 旧版と開発用の BOT (開発用には API キーが書かれている)。実行するのは smile_music3.py だけ
python/smile_music.py
python/smile_music2.py
python/smile_music_dev.py
# niconico DL キャッシュ (大きいので除外)
python/sm*.opus
python/mmrrHmDVtdw.opus

# --- runtime ---
database/

# --- secrets ---
.env
.env.*
!.env.example
# cookie ファイル (Netscape 形式)。BOT は cookiefile を使っていないので
# イメージに焼き込む必要はない。ファイル名の揺れを吸収するため広めに除外する。
**/*cookie*.txt
# API トークン類 (Cloudflare Pages のデプロイ用など)
**/*token*.txt

# --- LT / preview artefacts ---
activity/build_lt_slides.py
activity/LT_SmileMusic*.pptx
activity/preview_slide*.png

# --- misc ---
*.log
