# Discord Developer Portal > Application (Client) ID
# BOT 側の SMILEMUSIC3_DISCORD_CLIENT_ID と同じ値。
VITE_DISCORD_CLIENT_ID=

# トークン交換エンドポイント。
# Activity が Discord iframe で開かれた場合は URL Mapping 越し (`/.proxy/api/token`)、
# Standalone (vite dev 直アクセス) のときは FastAPI を直接叩く。
# 未設定時のデフォルトは `/.proxy/api/token`。
VITE_TOKEN_ENDPOINT=/.proxy/api/token
