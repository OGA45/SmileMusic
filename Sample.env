# ===== Postgres (全インスタンス共有・OGA_Music 専用DB) =====
POSTGRES_HOST=smile_music_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=smile_music
POSTGRES_PORT=5432

# ===== 共通 =====
YOUTUBE_TOKEN=
# Jellyfin 連携 (任意)
JELLYFIN_BASE_URL=
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# ===== OGA_Music アルファ (旧 smile_music3 / テーブル suffix "3") =====
SMILEMUSIC3_DISCORD_TOKEN=
SMILEMUSIC3_PREFIX=
SMILEMUSIC3_DISCORD_CLIENT_ID=
SMILEMUSIC3_DISCORD_CLIENT_SECRET=
SMILEMUSIC3_ACTIVITY_HOST=
# 管理画面 (/admin) のトークン。未設定なら管理画面は無効。生成例: openssl rand -hex 32
SMILEMUSIC3_ADMIN_TOKEN=

# ===== OGA_Music ベータ (旧 smile_music2 のBOTアカウント / suffix "2") =====
SMILEMUSIC2_DISCORD_TOKEN=
SMILEMUSIC2_PREFIX=
SMILEMUSIC2_DISCORD_CLIENT_ID=
SMILEMUSIC2_DISCORD_CLIENT_SECRET=
SMILEMUSIC2_ACTIVITY_HOST=
SMILEMUSIC2_ADMIN_TOKEN=

# ===== OGA_Music リリース (旧 smile_music のBOTアカウント / suffix なし) =====
SMILEMUSIC_DISCORD_TOKEN=
SMILEMUSIC_PREFIX=
SMILEMUSIC_DISCORD_CLIENT_ID=
SMILEMUSIC_DISCORD_CLIENT_SECRET=
SMILEMUSIC_ACTIVITY_HOST=
SMILEMUSIC_ADMIN_TOKEN=

# ===== ハブ画面 (3インスタンスの取りまとめ) =====
# 各インスタンスへの接続情報は docker-compose.yml 内で上の変数から配線される
OGA_HUB_ADMIN_TOKEN=
OGA_HUB_HOST=
